# Secretos — nunca versionar
secrets/
!secrets/*.example
.env
.env.*
!.env.example
*.secret
*.pem
*.pfx
*.p12
*.keystore
id_rsa*
.npmrc

# Documentación interna del GCBA — el repo es público
# Los PDF de la normativa son insumo de autoría, no dependencia de ejecución: el harness
# funciona sin ellos y nunca los copia a un proyecto. Lo que se distribuye son los extractos
# en markdown, que son destilado propio. Cada quien pone sus fuentes acá.
normativa/fuentes/*
!normativa/fuentes/.gitkeep
!normativa/fuentes/LEEME.md

# Estado runtime del harness en el propio repositorio. Se DERIVA de la evidencia en cada
# corrida: versionarlo seria dejar escrito que una fuente estaba al dia el dia que alguien
# corrio el comando, y que se lea como si lo estuviera hoy.
.claude/harness.*.json

# Salidas de prueba y trabajo local
tests/out/
*.log
*.tmp

# Windows
Thumbs.db
desktop.ini

# Cache de bytecode de Python. La suite lo genera en cada corrida.
__pycache__/
*.pyc
