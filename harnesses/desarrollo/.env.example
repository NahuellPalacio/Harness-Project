# Configuracion de las integraciones del harness, por desarrollador. Este archivo
# (.env.example) SI se commitea: es la plantilla, sin valores reales, y el harness reescribe
# este bloque en cada -Update. Lo que el proyecto tenga fuera del bloque no se toca.
#
# .env lo crea el instalador una sola vez y despues no lo toca nunca: completalo en tu
# maquina. El .gitignore lo excluye y Claude no puede leerlo (permissions.deny).
#
# Es el UNICO archivo que se completa. El harness lee de aca -o del entorno del proceso, que
# le gana- y genera .claude/harness.integraciones.json sin ningun secreto. Para ver que falta:
#
#     python .claude/harness/bin/desarrollo/dev-harness.py setup
#
# HARNESS_*_ENABLED acepta true/false, 1/0, yes/no, on/off. Un valor vacio o entre <> es
# que no esta cargado.

# Jira Cloud. Token de https://id.atlassian.com/manage-profile/security/api-tokens
HARNESS_JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_USER=
JIRA_TOKEN=<tu-api-token-de-jira>

# GitLab. Personal access token con scope read_api. GITLAB_PROJECT es opcional:
# el repositorio de este proyecto, como grupo/proyecto o su id.
HARNESS_GITLAB_ENABLED=false
GITLAB_BASE_URL=
GITLAB_PROJECT=
GITLAB_TOKEN=<tu-personal-access-token-de-gitlab>
