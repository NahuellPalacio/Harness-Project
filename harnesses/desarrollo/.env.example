# Tokens de las integraciones externas, por desarrollador. Este archivo (.env.example) SI
# se commitea -es la plantilla, sin valores reales- y el harness lo pisa en cada -Update.
# .env lo crea el instalador una sola vez y despues no lo toca nunca: completalo con tus
# propios tokens, en tu maquina. El .gitignore ya lo excluye del repositorio.
#
# ACA SOLO VAN TOKENS. La base URL, el usuario y que integraciones estan habilitadas van
# en .claude/harness.integraciones.json, que no es secreto y el agente si puede leer.
# Lo carga el setup:
#
#     python .claude/harness/bin/desarrollo/dev-harness.py setup

# Jira Cloud -- API token de https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=<tu-personal-access-token-de-jira>

# GitLab -- personal access token con scope read_api
GITLAB_TOKEN=<tu-personal-access-token-de-gitlab>

# OpenShift (OCP) -- todavia sin integracion; el lugar queda reservado
OPENSHIFT_TOKEN=<tu-token-de-acceso-de-openshift>
