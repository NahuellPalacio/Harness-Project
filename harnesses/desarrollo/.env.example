# Credenciales externas, por desarrollador. Nunca se commitea: .env.gitignore ya lo cubre.
#
# Este archivo (.env.example) SI se commitea -es la plantilla, sin valores reales- y el
# harness lo pisa en cada -Update. .env lo crea el instalador una sola vez, vacio, y
# despues no lo vuelve a tocar nunca: completalo con tus propios tokens, en tu maquina.

# Jira -- para trazabilidad de tickets.
JIRA_BASE_URL=<url-de-tu-instancia-jira>
JIRA_TOKEN=<tu-personal-access-token-de-jira>

# GitLab -- para trazabilidad de commits y merge requests.
GITLAB_BASE_URL=<url-de-tu-instancia-gitlab>
GITLAB_TOKEN=<tu-personal-access-token-de-gitlab>

# OpenShift (OCP) -- para trazabilidad de deploys.
OPENSHIFT_SERVER_URL=<url-del-api-server-de-tu-cluster>
OPENSHIFT_TOKEN=<tu-token-de-acceso-de-openshift>
